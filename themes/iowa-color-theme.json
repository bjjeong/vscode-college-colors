{
  "name": "Iowa Hawkeyes",
  "type": "dark",
  "colors": {
    "activityBar.background": "#110F09",
    "activityBar.foreground": "#FFCD00",
    "activityBar.inactiveForeground": "#A59771",
    "activityBar.border": "#060502",
    "activityBarBadge.background": "#FFCD00",
    "activityBarBadge.foreground": "#030201",
    "titleBar.activeBackground": "#110F09",
    "titleBar.activeForeground": "#FFCD00",
    "titleBar.inactiveBackground": "#060502",
    "titleBar.inactiveForeground": "#A59771",
    "statusBar.background": "#110F09",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#060502",
    "statusBar.debuggingBackground": "#FFCD00",
    "statusBar.debuggingForeground": "#030201",
    "statusBar.noFolderBackground": "#110F09",
    "statusBarItem.remoteBackground": "#FFCD00",
    "statusBarItem.remoteForeground": "#030201",
    "statusBarItem.hoverBackground": "#232019",
    "sideBar.background": "#201E19",
    "sideBar.foreground": "#E7E1D1",
    "sideBar.border": "#060502",
    "sideBarTitle.foreground": "#FFCD00",
    "sideBarSectionHeader.background": "#110F09",
    "sideBarSectionHeader.foreground": "#FFCD00",
    "tab.activeBackground": "#232019",
    "tab.activeForeground": "#FFCD00",
    "tab.activeBorderTop": "#FFCD00",
    "tab.inactiveBackground": "#060502",
    "tab.inactiveForeground": "#A59771",
    "tab.border": "#030201",
    "editorGroupHeader.tabsBackground": "#030201",
    "editor.background": "#302E27",
    "editor.foreground": "#F4F2EC",
    "editorLineNumber.foreground": "#948867",
    "editorLineNumber.activeForeground": "#FFCD00",
    "editorCursor.foreground": "#FFCD00",
    "editor.selectionBackground": "#FFCD0060",
    "editor.inactiveSelectionBackground": "#FFCD0035",
    "editor.lineHighlightBackground": "#23201980",
    "editorIndentGuide.background": "#4F4D47",
    "editorIndentGuide.activeBackground": "#FFCD00",
    "editorWhitespace.foreground": "#44423C",
    "editorWidget.background": "#060502",
    "editorSuggestWidget.background": "#060502",
    "editorSuggestWidget.selectedBackground": "#232019",
    "editorSuggestWidget.highlightForeground": "#FFCD00",
    "panel.background": "#201E19",
    "panel.border": "#060502",
    "panelTitle.activeBorder": "#FFCD00",
    "panelTitle.activeForeground": "#FFCD00",
    "panelTitle.inactiveForeground": "#A59771",
    "terminal.background": "#201E19",
    "terminal.foreground": "#E7E1D1",
    "terminal.ansiYellow": "#FFAD93",
    "terminal.ansiBlue": "#6EB2FE",
    "terminal.ansiGreen": "#A0D8A0",
    "terminal.ansiCyan": "#8CE3E3",
    "terminal.ansiMagenta": "#C691E9",
    "terminal.ansiRed": "#FF635E",
    "input.background": "#060502",
    "input.foreground": "#E7E1D1",
    "input.border": "#232019",
    "inputOption.activeBorder": "#FFCD00",
    "focusBorder": "#FFCD00",
    "button.background": "#FFCD00",
    "button.foreground": "#030201",
    "button.hoverBackground": "#E4B700",
    "badge.background": "#FFCD00",
    "badge.foreground": "#030201",
    "list.activeSelectionBackground": "#232019",
    "list.activeSelectionForeground": "#FFCD00",
    "list.inactiveSelectionBackground": "#060502",
    "list.hoverBackground": "#1B1811",
    "list.highlightForeground": "#FFCD00",
    "scrollbarSlider.background": "#23201980",
    "scrollbarSlider.hoverBackground": "#232019B0",
    "scrollbarSlider.activeBackground": "#FFCD00A0",
    "minimap.background": "#302E27",
    "minimapSlider.background": "#FFCD0030",
    "gitDecoration.modifiedResourceForeground": "#FFCD00",
    "gitDecoration.addedResourceForeground": "#A0D8A0",
    "gitDecoration.deletedResourceForeground": "#FF635E"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#838B69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFCD00"
      }
    },
    {
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FD8F64",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#A0D8A0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#7CC7E2"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#C691E9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6EB2FE"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#50D7C5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6EB2FE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8CE3E3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F1F3ED"
      }
    },
    {
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FFCD00"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9EA683"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFAD93"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF635E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FFCD00"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FFCD00",
        "fontStyle": "bold"
      }
    }
  ]
}
