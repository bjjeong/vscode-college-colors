    "panelTitle.activeForeground": "#CEB888",
    "panelTitle.inactiveForeground": "#B78B91",
    "terminal.background": "#3B0616",
    "terminal.foreground": "#EFDCDE",
    "terminal.ansiYellow": "#FFAD93",
    "terminal.ansiBlue": "#6EB2FE",
    "terminal.ansiGreen": "#A0D8A0",
    "terminal.ansiCyan": "#8CE3E3",
    "terminal.ansiMagenta": "#C691E9",
    "terminal.ansiRed": "#FF5B58",
    "input.background": "#501223",
    "input.foreground": "#EFDCDE",
    "input.border": "#832A41",
    "inputOption.activeBorder": "#CEB888",
    "focusBorder": "#CEB888",
    "button.background": "#CEB888",
    "button.foreground": "#460C1D",
    "button.hoverBackground": "#B8A273",
    "badge.background": "#CEB888",
    "badge.foreground": "#460C1D",
    "list.activeSelectionBackground": "#832A41",
    "list.activeSelectionForeground": "#CEB888",
    "list.inactiveSelectionBackground": "#501223",
    "list.hoverBackground": "#742439",
    "list.highlightForeground": "#CEB888",
    "scrollbarSlider.background": "#832A4180",
    "scrollbarSlider.hoverBackground": "#832A41B0",
    "scrollbarSlider.activeBackground": "#CEB888A0",
    "minimap.background": "#452128",
    "minimapSlider.background": "#CEB88830",
