{
  "name": "Georgia Bulldogs",
  "type": "dark",
  "colors": {
    "activityBar.background": "#40040B",
    "activityBar.foreground": "#FF5C66",
    "activityBar.inactiveForeground": "#B88B8A",
    "activityBar.border": "#2C0004",
    "activityBarBadge.background": "#FF5C66",
    "activityBarBadge.foreground": "#200003",
    "titleBar.activeBackground": "#40040B",
    "titleBar.activeForeground": "#FF5C66",
    "titleBar.inactiveBackground": "#2C0004",
    "titleBar.inactiveForeground": "#B88B8A",
    "statusBar.background": "#40040B",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#2C0004",
    "statusBar.debuggingBackground": "#FF5C66",
    "statusBar.debuggingForeground": "#200003",
    "statusBar.noFolderBackground": "#40040B",
    "statusBarItem.remoteBackground": "#FF5C66",
    "statusBarItem.remoteForeground": "#200003",
    "statusBarItem.hoverBackground": "#5D1018",
    "sideBar.background": "#390B0F",
    "sideBar.foreground": "#F0DCDB",
    "sideBar.border": "#2C0004",
    "sideBarTitle.foreground": "#FF5C66",
    "sideBarSectionHeader.background": "#40040B",
    "sideBarSectionHeader.foreground": "#FF5C66",
    "tab.activeBackground": "#5D1018",
    "tab.activeForeground": "#FF5C66",
    "tab.activeBorderTop": "#FF5C66",
    "tab.inactiveBackground": "#2C0004",
    "tab.inactiveForeground": "#B88B8A",
    "tab.border": "#200003",
    "editorGroupHeader.tabsBackground": "#200003",
    "editor.background": "#462222",
    "editor.foreground": "#F7F0EF",
    "editorLineNumber.foreground": "#A67E7C",
    "editorLineNumber.activeForeground": "#FF5C66",
    "editorCursor.foreground": "#FF5C66",
    "editor.selectionBackground": "#FF5C6660",
    "editor.inactiveSelectionBackground": "#FF5C6635",
    "editor.lineHighlightBackground": "#5D101880",
    "editorIndentGuide.background": "#73393A",
    "editorIndentGuide.activeBackground": "#FF5C66",
    "editorWhitespace.foreground": "#653031",
    "editorWidget.background": "#2C0004",
    "editorSuggestWidget.background": "#2C0004",
    "editorSuggestWidget.selectedBackground": "#5D1018",
    "editorSuggestWidget.highlightForeground": "#FF5C66",
    "panel.background": "#390B0F",
    "panel.border": "#2C0004",
    "panelTitle.activeBorder": "#FF5C66",
    "panelTitle.activeForeground": "#FF5C66",
    "panelTitle.inactiveForeground": "#B88B8A",
    "terminal.background": "#390B0F",
    "terminal.foreground": "#F0DCDB",
    "terminal.ansiYellow": "#FDAF87",
    "terminal.ansiBlue": "#6EB2FE",
    "terminal.ansiGreen": "#A0D8A0",
    "terminal.ansiCyan": "#8CE3E3",
    "terminal.ansiMagenta": "#C691E9",
    "terminal.ansiRed": "#FA55B6",
    "input.background": "#2C0004",
    "input.foreground": "#F0DCDB",
    "input.border": "#5D1018",
    "inputOption.activeBorder": "#FF5C66",
    "focusBorder": "#FF5C66",
    "button.background": "#FF5C66",
    "button.foreground": "#200003",
    "button.hoverBackground": "#E64352",
    "badge.background": "#FF5C66",
    "badge.foreground": "#200003",
    "list.activeSelectionBackground": "#5D1018",
    "list.activeSelectionForeground": "#FF5C66",
    "list.inactiveSelectionBackground": "#2C0004",
    "list.hoverBackground": "#4F0A12",
    "list.highlightForeground": "#FF5C66",
    "scrollbarSlider.background": "#5D101880",
    "scrollbarSlider.hoverBackground": "#5D1018B0",
    "scrollbarSlider.activeBackground": "#FF5C66A0",
    "minimap.background": "#462222",
    "minimapSlider.background": "#FF5C6630",
    "gitDecoration.modifiedResourceForeground": "#FF5C66",
    "gitDecoration.addedResourceForeground": "#A0D8A0",
    "gitDecoration.deletedResourceForeground": "#FA55B6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A07E6C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF5C66"
      }
    },
    {
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#FA9259",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#A0D8A0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#7CC7E2"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#C691E9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6EB2FE"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#50D7C5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6EB2FE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8CE3E3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F7F0ED"
      }
    },
    {
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FF5C66"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#BC9987"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FDAF87"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FA55B6",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FF5C66"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FF5C66",
        "fontStyle": "bold"
      }
    }
  ]
}
