{
  "name": "Wisconsin Badgers",
  "type": "dark",
  "colors": {
    "activityBar.background": "#400403",
    "activityBar.foreground": "#FF5C4E",
    "activityBar.inactiveForeground": "#B88C85",
    "activityBar.border": "#2C0000",
    "activityBarBadge.background": "#FF5C4E",
    "activityBarBadge.foreground": "#210000",
    "titleBar.activeBackground": "#400403",
    "titleBar.activeForeground": "#FF5C4E",
    "titleBar.inactiveBackground": "#2C0000",
    "titleBar.inactiveForeground": "#B88C85",
    "statusBar.background": "#400403",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#2C0000",
    "statusBar.debuggingBackground": "#FF5C4E",
    "statusBar.debuggingForeground": "#210000",
    "statusBar.noFolderBackground": "#400403",
    "statusBarItem.remoteBackground": "#FF5C4E",
    "statusBarItem.remoteForeground": "#210000",
    "statusBarItem.hoverBackground": "#5D120D",
    "sideBar.background": "#390C09",
    "sideBar.foreground": "#F0DCD9",
    "sideBar.border": "#2C0000",
    "sideBarTitle.foreground": "#FF5C4E",
    "sideBarSectionHeader.background": "#400403",
    "sideBarSectionHeader.foreground": "#FF5C4E",
    "tab.activeBackground": "#5D120D",
    "tab.activeForeground": "#FF5C4E",
    "tab.activeBorderTop": "#FF5C4E",
    "tab.inactiveBackground": "#2C0000",
    "tab.inactiveForeground": "#B88C85",
    "tab.border": "#210000",
    "editorGroupHeader.tabsBackground": "#210000",
    "editor.background": "#46221E",
    "editor.foreground": "#F7F0EF",
    "editorLineNumber.foreground": "#A57E78",
    "editorLineNumber.activeForeground": "#FF5C4E",
    "editorCursor.foreground": "#FF5C4E",
    "editor.selectionBackground": "#FF5C4E60",
    "editor.inactiveSelectionBackground": "#FF5C4E35",
    "editor.lineHighlightBackground": "#5D120D80",
    "editorIndentGuide.background": "#733A33",
    "editorIndentGuide.activeBackground": "#FF5C4E",
    "editorWhitespace.foreground": "#65312B",
    "editorWidget.background": "#2C0000",
    "editorSuggestWidget.background": "#2C0000",
    "editorSuggestWidget.selectedBackground": "#5D120D",
    "editorSuggestWidget.highlightForeground": "#FF5C4E",
    "panel.background": "#390C09",
    "panel.border": "#2C0000",
    "panelTitle.activeBorder": "#FF5C4E",
    "panelTitle.activeForeground": "#FF5C4E",
    "panelTitle.inactiveForeground": "#B88C85",
    "terminal.background": "#390C09",
    "terminal.foreground": "#F0DCD9",
    "terminal.ansiYellow": "#F9B27F",
    "terminal.ansiBlue": "#6EB2FE",
    "terminal.ansiGreen": "#A0D8A0",
    "terminal.ansiCyan": "#8CE3E3",
    "terminal.ansiMagenta": "#C691E9",
    "terminal.ansiRed": "#FA55B6",
    "input.background": "#2C0000",
    "input.foreground": "#F0DCD9",
    "input.border": "#5D120D",
    "inputOption.activeBorder": "#FF5C4E",
    "focusBorder": "#FF5C4E",
    "button.background": "#FF5C4E",
    "button.foreground": "#210000",
    "button.hoverBackground": "#E64338",
    "badge.background": "#FF5C4E",
    "badge.foreground": "#210000",
    "list.activeSelectionBackground": "#5D120D",
    "list.activeSelectionForeground": "#FF5C4E",
    "list.inactiveSelectionBackground": "#2C0000",
    "list.hoverBackground": "#4F0B08",
    "list.highlightForeground": "#FF5C4E",
    "scrollbarSlider.background": "#5D120D80",
    "scrollbarSlider.hoverBackground": "#5D120DB0",
    "scrollbarSlider.activeBackground": "#FF5C4EA0",
    "minimap.background": "#46221E",
    "minimapSlider.background": "#FF5C4E30",
    "gitDecoration.modifiedResourceForeground": "#FF5C4E",
    "gitDecoration.addedResourceForeground": "#A0D8A0",
    "gitDecoration.deletedResourceForeground": "#FA55B6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9E7F69",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF5C4E"
      }
    },
    {
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#F6974C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#A0D8A0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#7CC7E2"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#C691E9"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6EB2FE"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#50D7C5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6EB2FE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8CE3E3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F6F0ED"
      }
    },
    {
      "scope": [
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FF5C4E"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#BB9A84"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#F9B27F"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FA55B6",
        "fontStyle": "bold underline"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#FF5C4E"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FF5C4E",
        "fontStyle": "bold"
      }
    }
  ]
}
