{
  "name": "college-colors",
  "displayName": "College Colors",
  "description": "VS Code themes in the colors of 29 well-known universities — Michigan, Ohio State, Alabama, Texas, Notre Dame, LSU, Harvard, MIT, NYU and more. One dark and one light theme per school: the official palette drives the editor chrome, with a syntax scheme tuned for contrast against it.",
  "version": "1.1.0",
  "publisher": "bjjeong",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bjjeong/vscode-college-colors"
  },
  "bugs": {
    "url": "https://github.com/bjjeong/vscode-college-colors/issues"
  },
  "homepage": "https://github.com/bjjeong/vscode-college-colors#readme",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark theme",
    "college",
    "university",
    "school colors",
    "ncaa"
  ],
  "galleryBanner": {
    "color": "#1A1A1A",
    "theme": "dark"
  },
  "scripts": {
    "build": "node scripts/build-themes.mjs",
    "validate": "node scripts/validate-themes.mjs",
    "test": "npm run build && npm run validate",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
